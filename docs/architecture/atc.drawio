        <mxCell id="db" value="plane-db (Postgres)&#xa;schema atc: read/write&#xa;Plane tables: read only" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="luke"><mxGeometry x="10" y="40" width="180" height="120" as="geometry"/></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;" edge="1" parent="1" source="mcp" target="leia"><mxGeometry relative="1" as="geometry"/></mxCell>
